     />            ))}          </div>        </>      )}    </section>  )}export default function Home() {  const dispatch = useDispatch()  const slides = useSelector(selectSlides)  const popularProducts = useSelector(selectPopularProducts)  const categories = useSelector(selectHomeCategories)  const recommended = useSelector(selectRecommended)  const isLoading = useSelector(selectHomeLoading)  const settings = useSelector(selectSettings)  const homeFeatures = useSelector(selectHomeFeatures)  const sliderRef = useRef(null)  const recommendedRef = useRef(null)  const features = homeFeatures.map((f) => ({    ...f,    text: (f.text || '').replace('{threshold}', `$${settings.free_shipping_threshold}`),  }))  function cardStep(el) {    const card = el?.firstElementChild    return (card?.offsetWidth || 240) + 24  }  function scrollSlider(direction) {    const el = sliderRef.current    if (!el) return    el.scrollBy({ left: direction * cardStep(el), behavior: 'smooth' })  }  function scrollRecommended(direction) {    const el = recommendedRef.current    if (!el) return    el.scrollBy({ left: direction * cardStep(el), behavior: 'smooth' })  }  useEffect(() => {    dispatch(fetchHome())  }, [dispatch])  return (    <div>      <HeroSlider slides={slides} />      {recommended.length > 0 && (        <section className="max-w-6xl mx-auto px-4 pt-10 pb-16">          <div className="flex items-end justify-between mb-8">            <div>              <h2 className="text-2xl md:text-3xl font-bold">Recommended for you</h2>              <p className="text-gray-500 mt-1">Based on your cart and past purchases</p>            </div>            <div className="flex items-center gap-3">              <Link to="/shop" className="text-primary font-medium hover:underline shrink-0">                See all →              </Link>              <div className="flex gap-2">                <button                  onClick={() => scrollRecommended(-1)}                  className="w-9 h-9 rounded-full 